APP_ENV=local
LOG_LEVEL=debug

TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE_URL=https://api.telegram.org

# Канал, на который пользователь должен быть подписан: @username (или ссылка
# t.me/...) либо числовой id. Бота нужно добавить в канал администратором —
# иначе Telegram не отдает статус подписчиков. Пустое значение — бот открыт всем.
TELEGRAM_REQUIRED_CHANNEL=
# Ссылка на канал для кнопки «Подписаться». Для @username выводится сама;
# обязательна, если канал указан числовым id (приватный канал — invite-ссылка).
TELEGRAM_CHANNEL_URL=

PROXY_URL=

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-3-flash-preview,google/gemini-2.5-flash,openai/gpt-5-mini
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=Ojirun

DATABASE_URL=postgres://nutrition:nutrition@postgres:5432/nutrition?sslmode=disable

APP_TIMEZONE=Europe/Moscow

DAILY_REPORT_TIME=09:00

PHOTO_STORAGE_DIR=/app/storage/photos

MAX_PHOTO_BYTES=10485760
MAX_CONCURRENT_UPDATES=32
MAX_CONCURRENT_AI=4
MAX_MEALS_PER_DAY=10
MAX_MEALS_PER_CHAT_PER_DAY=100
MAX_MEALS_IN_FLIGHT=3

REPORT_WORKERS=2

